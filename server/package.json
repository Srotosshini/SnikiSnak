{
  "private": true,
  "name": "server",
  "version": "0.1.0",
  "description": "SnikiSnak game server (Colyseus). Owns the truth: cat, items, doors, jars, win and lose.",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts --serve-client",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx \"test/**/*.test.ts\" --exit --timeout 15000",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "@snikisnak/shared": "*",
    "colyseus": "^0.18.2",
    "express": "^5.2.1"
  }
}
